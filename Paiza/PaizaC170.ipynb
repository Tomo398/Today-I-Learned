   "source": [
    "N,M = map(int,input().split())\n",
    "T = list(map(int,input().split()))\n",
    "\n",
    "total = 0\n",
    "get_points = 0\n",
    "for i in range(N):\n",
    "    get_points += T[i] // 100\n",
    "    \n",
    "if get_points >= M:\n",
    "    print(\"0\")\n",
    "else:\n",
    "    total = (M - get_points) * 100\n",
    "    print(total)"
   ]
  }
