   "source": [
    "#PaizaC177\n",
    "N = int(input())\n",
    "K,M = map(int,input().split())\n",
    "Q = list(map(int,input().split()))\n",
    "\n",
    "count = 0\n",
    "fee = 0\n",
    "for i in range(len(Q)):\n",
    "    fee +=Q[i]\n",
    "    if Q[i]>=K:\n",
    "        count +=1\n",
    "    else :\n",
    "        continue\n",
    "\n",
    "if count>=3 and fee >=M:\n",
    "    print(\"silver\")\n",
    "else:\n",
    "    print(\"bronze\")"
   ]
  }
