    "#C163\n",
    "N = int(input())\n",
    "h = list(map(int,input().split()))\n",
    "power = 0\n",
    "for i in range(N):\n",
    "    power = power - h[i]\n",
    "    if power < 0:\n",
    "        print(\"NO\")\n",
    "        break\n",
    "if power >=0:\n",
    "    print(\"YES\")"
