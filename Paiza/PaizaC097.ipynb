    "#Paiza C097\n",
    "N,X,Y = map(int,input().split())\n",
    "\n",
    "i = 1\n",
    "\n",
    "while i <= N:\n",
    "    if i % X == 0 and i % Y == 0:\n",
    "        print(\"AB\")\n",
    "    elif i % X == 0:\n",
    "        print(\"A\")\n",
    "    elif i % Y == 0:\n",
    "        print(\"B\")\n",
    "    else:\n",
    "        print(\"N\")\n",
    "    i +=1"
   ]
