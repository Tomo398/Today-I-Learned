   "source": [
    "#S016\n",
    "s = list(input())\n",
    "\n",
    "dic = {\"A\":4,\"E\":3,\"G\":6,\"I\":1,\"O\":0,\"S\":5,\"Z\":2}\n",
    "change=\"\"\n",
    "\n",
    "for i in range(len(s)):\n",
    "    if s[i] in dic:\n",
    "        change += str(dic[s[i]])\n",
    "    else:\n",
    "        change += s[i]\n",
    "        \n",
    "print(change)\n",
    "        "
   ]
  },
