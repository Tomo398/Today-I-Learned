   "source": [
    "#C150\n",
    "N,D = map(int,input().split())\n",
    "X,Y = map(int,input().split())\n",
    "\n",
    "count = 0\n",
    "for i in range(N):\n",
    "    x_i,y_i = map(int,input().split())\n",
    "    distance_i = abs(X-x_i)+abs(Y-y_i)\n",
    "    if distance_i <= D:\n",
    "        count += 1\n",
    "        \n",
    "print(count)\n"
   ]
  }
