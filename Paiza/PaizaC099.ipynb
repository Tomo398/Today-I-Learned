   "source": [
    "#PaizaC099\n",
    "N,D = map(int,input().split())\n",
    "\n",
    "count = D\n",
    "for i in range(N-1):\n",
    "        d_i = int(input())\n",
    "        count += (D-d_i)\n",
    "\n",
    "if N >0:\n",
    "    print(D*count)\n",
    "else:\n",
    "    print(0)"
   ]
  }
